{
  "name": "@rid/transparency-verifier",
  "version": "0.0.0",
  "private": true,
  "description": "Verifies transparency receipts of the RID network without trusting the portal (ADR-0016)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
