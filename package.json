{
  "name": "rid-portal",
  "version": "0.0.0",
  "private": true,
  "description": "Portal RID: developer portal and governance console for a national data exchange network",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --dir scripts",
    "test:policy": "node scripts/opa-test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node scripts/license-check.mjs",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env --profile observability up -d --build --wait --wait-timeout 180",
    "infra:up:core": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d --build --wait --wait-timeout 180",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env --profile observability down",
    "infra:reset": "docker compose -f infra/compose/docker-compose.yml --env-file .env --profile observability down --volumes",
    "infra:ps": "docker compose -f infra/compose/docker-compose.yml --env-file .env --profile observability ps",
    "infra:logs": "docker compose -f infra/compose/docker-compose.yml --env-file .env --profile observability logs -f --tail=100",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @rid/web test:e2e",
    "db:migrate": "pnpm --filter @rid/api db:migrate",
    "db:deploy": "pnpm --filter @rid/api db:deploy",
    "db:seed": "pnpm --filter @rid/api db:seed",
    "demo": "node scripts/demo.mjs",
    "demo:otp": "node scripts/totp.mjs",
    "traffic:simulate": "pnpm --filter @rid/api traffic:simulate",
    "load:seed": "pnpm --filter @rid/api load:seed",
    "load:test": "node scripts/load-test.mjs",
    "resilience:test": "node scripts/resilience-test.mjs",
    "helm:sync": "node scripts/helm-sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
