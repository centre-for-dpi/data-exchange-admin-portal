next-env.d.ts

# Prisma client (generated by `prisma generate`)
apps/api/src/generated/

# Brainstorming mockups (local only)
.superpowers/

# Browser tool artifacts
.playwright-mcp/

# Schemathesis cache when the contract runner runs on the host (M4-06)
.schemathesis/

# Single-host installer (install.sh): generated proxy routes, the portal's own certificate, backups
infra/edge/dynamic/
infra/edge/certs/
backups/

# Helm dependencies: Chart.lock pins them, `helm dependency build` fetches them (M6-05)
infra/helm/*/charts/
