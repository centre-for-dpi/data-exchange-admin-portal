.env
.env.*
!.env.example
*.pem
*.key

# Test artifacts
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
