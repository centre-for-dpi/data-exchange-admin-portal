{
  "name": "@rid/api",
  "version": "0.0.0",
  "private": true,
  "description": "Portal API: domain, workflows, authorization, audit, reconcilers and OPA bundle",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "prisma generate && vitest run",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:pgboss-migration": "node scripts/pgboss-migration.mjs",
    "db:seed": "tsx src/seed/main.ts",
    "test:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rid/config": "workspace:*",
    "@rid/contracts": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.2.36",
    "@stoplight/spectral-core": "^1.24.1",
    "@stoplight/spectral-functions": "^1.11.1",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.23.1",
    "fastify": "5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
