// Portal database schema (SPEC.md §3). IDs are UUIDv7 generated by PostgreSQL 18 (uuidv7());
// timestamps are stored in UTC. Nothing is physically deleted in the domain: rows change status.
// `createdBy` holds the actor that created the row: a user id, or `system:<component>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
  // Partial unique index: one live subscription per application, API version and purpose.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  user
  system
  application

  @@map("actor_type")
}

/// Append-only audit log (SPEC.md §3). The runtime role cannot UPDATE or DELETE rows.
/// prev_hash/hash are filled by the hash chain in M1-11.
model AuditEvent {
  seq           BigInt    @id @default(autoincrement())
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType     ActorType @map("actor_type")
  /// Keycloak sub of a user, application id, or the name of a system component.
  actorId       String    @map("actor_id")
  actorEntityId String?   @map("actor_entity_id") @db.Uuid
  /// Dotted action name, e.g. subscription.approved.
  action        String
  targetType    String    @map("target_type")
  targetId      String    @map("target_id")
  /// Domain fields only; secrets are stripped before writing.
  before        Json?
  after         Json?
  ip            String?
  requestId     String?   @map("request_id")
  prevHash      String?   @map("prev_hash")
  hash          String?

  @@index([targetType, targetId, seq])
  @@index([actorEntityId, occurredAt])
  @@map("audit_event")
}

/// Transactional outbox (ADR-0007): written in the same transaction as the domain change,
/// relayed to pg-boss queues by the worker.
model OutboxMessage {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Queue name, e.g. gateway.sync.
  topic       String
  /// What must be reconciled, e.g. apiVersion:<uuid>. Used as the job singleton key.
  aggregate   String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([createdAt], map: "outbox_pending_idx")
  @@map("outbox")
}

// ---------------------------------------------------------------------------------------------
// Entities, users and roles (SPEC.md §2, §3). Roles live here, not in Keycloak (ADR-0004).
// ---------------------------------------------------------------------------------------------

enum EntityKind {
  national
  territorial
  autonomous
  private_authorized

  @@map("entity_kind")
}

/// SPEC.md §4.1
enum EntityStatus {
  requested
  under_review
  active
  rejected
  suspended
  offboarded

  @@map("entity_status")
}

model Entity {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  legalName      String       @map("legal_name")
  shortName      String       @map("short_name")
  /// URL-safe identifier; first segment of every gateway path: /{entitySlug}/{apiSlug}/v{major}
  slug           String       @unique
  /// Organization identifier type from the country config (identifiers.organization).
  taxIdType      String       @map("tax_id_type")
  taxId          String       @map("tax_id")
  kind           EntityKind
  /// Sector code from the country config (sectors[].code).
  sector         String
  parentEntityId String?      @map("parent_entity_id") @db.Uuid
  parentEntity   Entity?      @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  childEntities  Entity[]     @relation("EntityHierarchy")
  status         EntityStatus @default(requested)
  contactEmail   String       @map("contact_email")
  website        String?
  /// Data protection officer.
  dpoName        String       @map("dpo_name")
  dpoEmail       String       @map("dpo_email")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String       @map("created_by")

  memberships  Membership[]
  apis         Api[]
  applications Application[]

  @@unique([taxIdType, taxId])
  @@index([status])
  @@map("entity")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id                   String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Subject (sub) of the user in the Keycloak realm rid-portal.
  keycloakSub          String     @unique @map("keycloak_sub")
  email                String     @unique
  fullName             String     @map("full_name")
  idDocumentType       String?    @map("id_document_type")
  /// Salted hash only; the document number is never stored in clear (SPEC.md §3).
  idDocumentNumberHash String?    @map("id_document_number_hash")
  status               UserStatus @default(active)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            String     @map("created_by")

  memberships   Membership[]
  platformRoles UserPlatformRole[]

  @@map("app_user")
}

/// SPEC.md §2.1. Same values as PLATFORM_ROLES in packages/contracts.
enum PlatformRole {
  platform_admin
  platform_reviewer
  regulator
  auditor

  @@map("platform_role")
}

/// SPEC.md §2.2. Same values as ENTITY_ROLES in packages/contracts.
enum EntityRole {
  entity_admin
  api_publisher
  data_steward
  app_developer
  entity_viewer

  @@map("entity_role")
}

/// Platform roles are not tied to an entity. One row per grant, so every change is auditable.
model UserPlatformRole {
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id])
  role      PlatformRole
  grantedBy String       @map("granted_by")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, role])
  @@map("user_platform_role")
}

enum MembershipStatus {
  invited
  active
  revoked

  @@map("membership_status")
}

model Membership {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  entityId  String           @map("entity_id") @db.Uuid
  entity    Entity           @relation(fields: [entityId], references: [id])
  roles     EntityRole[]
  status    MembershipStatus @default(invited)
  invitedBy String?          @map("invited_by")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String           @map("created_by")

  @@unique([userId, entityId])
  @@index([entityId])
  @@map("membership")
}

// ---------------------------------------------------------------------------------------------
// Purposes (SPEC.md §3). Seeded from the country config; the operator can extend it (M2-10).
// ---------------------------------------------------------------------------------------------

enum PurposeSource {
  config
  operator

  @@map("purpose_source")
}

model Purpose {
  /// lower snake_case, stable (e.g. eligibility_check).
  code           String        @id
  /// Localized text, same shape as the country config: a string or { es, en }.
  name           Json
  description    Json
  legalReference String?       @map("legal_reference")
  source         PurposeSource
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String        @map("created_by")

  apiVersions   ApiVersionPurpose[]
  subscriptions Subscription[]

  @@map("purpose")
}

// ---------------------------------------------------------------------------------------------
// APIs and versions (SPEC.md §3, §4.2)
// ---------------------------------------------------------------------------------------------

enum Classification {
  public
  internal
  personal
  sensitive

  @@map("classification")
}

/// Derived from the versions (SPEC.md §3). Stored so the catalogue can filter on it, and updated in
/// the same transaction as every version transition.
enum ApiStatus {
  draft
  published
  deprecated
  retired

  @@map("api_status")
}

model Api {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Provider entity.
  entityId       String         @map("entity_id") @db.Uuid
  entity         Entity         @relation(fields: [entityId], references: [id])
  /// Unique per entity; second segment of the gateway path.
  slug           String
  name           String
  summary        String
  /// Markdown.
  description    String
  /// Sector code from the country config.
  sector         String
  tags           String[]
  classification Classification
  status         ApiStatus      @default(draft)
  ownerContact   String         @map("owner_contact")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String         @map("created_by")

  versions ApiVersion[]

  @@unique([entityId, slug])
  @@index([status, classification])
  @@map("api")
}

/// SPEC.md §4.2
enum ApiVersionStatus {
  draft
  in_review
  changes_requested
  approved_operator
  approved_regulator
  published
  deprecated
  retired

  @@map("api_version_status")
}

enum UpstreamType {
  node
  xroad
  direct

  @@map("upstream_type")
}

model ApiVersion {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiId            String           @map("api_id") @db.Uuid
  api              Api              @relation(fields: [apiId], references: [id])
  /// "major.minor"
  version          String
  major            Int
  minor            Int
  status           ApiVersionStatus @default(draft)
  /// OpenAPI 3.x document as uploaded and its SHA-256. `json` (not jsonb) keeps the key order of
  /// the document, so paths and operations are shown in the order the provider wrote them.
  openapiSpec      Json             @map("openapi_spec") @db.Json
  openapiSha256    String           @map("openapi_sha256")
  lintReport       Json?            @map("lint_report")
  upstreamType     UpstreamType     @map("upstream_type")
  /// Shape depends on upstreamType (SPEC.md §3.1); validated with zod in packages/contracts.
  upstream         Json
  /// /{entitySlug}/{apiSlug}/v{major}
  basePath         String           @map("base_path")
  /// [{ name, personal, sensitive }]: personal data the API exposes (minimization, SPEC.md §5).
  exposedFields    Json             @default("[]") @map("exposed_fields")
  legalBasisText   String?          @map("legal_basis_text")
  legalReferences  String[]         @map("legal_references")
  /// { availabilityTarget, maxLatencyMs, supportHours }
  sla              Json?
  /// Requests per minute per subscription unless the subscription says otherwise.
  defaultRateLimit Int              @default(600) @map("default_rate_limit")
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  deprecatedAt     DateTime?        @map("deprecated_at") @db.Timestamptz(3)
  sunsetAt         DateTime?        @map("sunset_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String           @map("created_by")

  allowedPurposes ApiVersionPurpose[]
  subscriptions   Subscription[]

  @@unique([apiId, major, minor])
  @@unique([apiId, version])
  @@index([status])
  @@map("api_version")
}

/// Purposes a version lets consumers request (SPEC.md §3: allowedPurposes).
model ApiVersionPurpose {
  apiVersionId String     @map("api_version_id") @db.Uuid
  apiVersion   ApiVersion @relation(fields: [apiVersionId], references: [id])
  purposeCode  String     @map("purpose_code")
  purpose      Purpose    @relation(fields: [purposeCode], references: [code])

  @@id([apiVersionId, purposeCode])
  @@map("api_version_purpose")
}

// ---------------------------------------------------------------------------------------------
// Consumer applications and credentials (SPEC.md §3, §4.3)
// ---------------------------------------------------------------------------------------------

enum AppEnvironment {
  sandbox
  production

  @@map("app_environment")
}

enum ApplicationStatus {
  active
  suspended
  deleted

  @@map("application_status")
}

model Application {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Consumer entity.
  entityId         String            @map("entity_id") @db.Uuid
  entity           Entity            @relation(fields: [entityId], references: [id])
  name             String
  description      String
  environment      AppEnvironment
  /// Deterministic client id in the Keycloak realm rid-gateway: rid-app-<id>.
  keycloakClientId String            @unique @map("keycloak_client_id")
  status           ApplicationStatus @default(active)
  technicalContact String            @map("technical_contact")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String            @map("created_by")

  credentials   Credential[]
  subscriptions Subscription[]

  @@index([entityId, status])
  @@map("application")
}

enum CredentialKind {
  client_secret
  mtls_certificate

  @@map("credential_kind")
}

enum CredentialStatus {
  active
  rotating
  revoked
  expired

  @@map("credential_status")
}

/// Metadata only: secrets are shown once and never stored by the portal (SPEC.md §3).
model Credential {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId String           @map("application_id") @db.Uuid
  application   Application      @relation(fields: [applicationId], references: [id])
  kind          CredentialKind
  status        CredentialStatus @default(active)
  /// Certificate SHA-256 fingerprint (mTLS), or null for client secrets.
  fingerprint   String?
  serial        String?
  notAfter      DateTime?        @map("not_after") @db.Timestamptz(3)
  lastUsedAt    DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy     String           @map("created_by")

  @@index([applicationId, status])
  @@map("credential")
}

// ---------------------------------------------------------------------------------------------
// Subscriptions: access requests and grants (SPEC.md §3, §4.4)
// ---------------------------------------------------------------------------------------------

/// SPEC.md §4.4. "Pedir información" (M2-06) will add its own state.
enum SubscriptionStatus {
  pending_provider
  pending_regulator
  approved
  active
  suspended
  revoked
  expired
  rejected
  withdrawn

  @@map("subscription_status")
}

model Subscription {
  id                            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId                 String             @map("application_id") @db.Uuid
  application                   Application        @relation(fields: [applicationId], references: [id])
  apiVersionId                  String             @map("api_version_id") @db.Uuid
  apiVersion                    ApiVersion         @relation(fields: [apiVersionId], references: [id])
  purposeCode                   String             @map("purpose_code")
  purpose                       Purpose            @relation(fields: [purposeCode], references: [code])
  purposeDetail                 String             @map("purpose_detail")
  legalBasisText                String             @map("legal_basis_text")
  legalReference                String?            @map("legal_reference")
  /// Agreement document (the Document model arrives in M2-07).
  agreementDocumentId           String?            @map("agreement_document_id") @db.Uuid
  /// operationIds requested; empty = every read-only operation (SPEC.md §3).
  requestedOperations           String[]           @map("requested_operations")
  /// operationIds granted by the data steward (may be fewer than requested).
  approvedOperations            String[]           @map("approved_operations")
  requestedRateLimit            Int?               @map("requested_rate_limit")
  /// Granted requests per minute; null = the version's defaultRateLimit.
  rateLimitPerMinute            Int?               @map("rate_limit_per_minute")
  validFrom                     DateTime           @map("valid_from") @db.Timestamptz(3)
  validUntil                    DateTime           @map("valid_until") @db.Timestamptz(3)
  status                        SubscriptionStatus @default(pending_provider)
  endUserIdentificationRequired Boolean            @default(false) @map("end_user_identification_required")
  /// User who asked for access. Separation of duties: that user can never approve it.
  requestedBy                   String             @map("requested_by") @db.Uuid
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                     String             @map("created_by")

  decisions SubscriptionDecision[]

  /// At most one live subscription per application, API version and purpose (SPEC.md §4.4).
  /// The predicate is written exactly as PostgreSQL normalizes it, so Prisma sees no drift.
  @@unique([applicationId, apiVersionId, purposeCode], map: "subscription_one_live_per_purpose", where: raw("(status = ANY (ARRAY['pending_provider'::subscription_status, 'pending_regulator'::subscription_status, 'approved'::subscription_status, 'active'::subscription_status, 'suspended'::subscription_status]))"))
  @@index([apiVersionId, status])
  @@index([status, validUntil])
  @@map("subscription")
}

enum DecisionKind {
  approved
  rejected
  info_requested
  suspended
  reactivated
  revoked

  @@map("decision_kind")
}

/// Who decided what on a subscription, and why (SPEC.md §3: decisions[]).
model SubscriptionDecision {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriptionId    String       @map("subscription_id") @db.Uuid
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  decision          DecisionKind
  decidedBy         String       @map("decided_by") @db.Uuid
  /// Entity on whose behalf the user decided, or null for platform roles (operator, regulator).
  decidedByEntityId String?      @map("decided_by_entity_id") @db.Uuid
  comment           String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subscriptionId, createdAt])
  @@map("subscription_decision")
}

// ---------------------------------------------------------------------------------------------
// Reconciliation state (ARCHITECTURE.md §4)
// ---------------------------------------------------------------------------------------------

enum SyncStatus {
  pending
  in_sync
  drift
  error

  @@map("sync_status")
}

/// Last desired and applied state per external object (APISIX route, Keycloak client, OPA bundle).
model SyncState {
  /// Deterministic external id, e.g. apisix:route:rid-route-<apiVersionId>.
  target      String     @id
  /// apisix | keycloak | opa
  system      String
  desiredHash String     @map("desired_hash")
  appliedHash String?    @map("applied_hash")
  status      SyncStatus @default(pending)
  lastError   String?    @map("last_error")
  attempts    Int        @default(0)
  appliedAt   DateTime?  @map("applied_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("sync_state")
}
