// Portal database schema (SPEC.md §3). IDs are UUIDv7 generated by PostgreSQL 18 (uuidv7());
// timestamps are stored in UTC. Nothing is physically deleted in the domain: rows change status.
// `createdBy` holds the actor that created the row: a user id, or `system:<component>`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
  // Partial unique index: one live subscription per application, API version and purpose.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ActorType {
  user
  system
  application

  @@map("actor_type")
}

/// Append-only audit log (SPEC.md §3). The runtime role cannot UPDATE or DELETE rows.
/// prev_hash/hash are filled by the hash chain in M1-11.
model AuditEvent {
  seq           BigInt    @id @default(autoincrement())
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType     ActorType @map("actor_type")
  /// Keycloak sub of a user, application id, or the name of a system component.
  actorId       String    @map("actor_id")
  actorEntityId String?   @map("actor_entity_id") @db.Uuid
  /// Dotted action name, e.g. subscription.approved.
  action        String
  targetType    String    @map("target_type")
  targetId      String    @map("target_id")
  /// Domain fields only; secrets are stripped before writing.
  before        Json?
  after         Json?
  ip            String?
  requestId     String?   @map("request_id")
  prevHash      String?   @map("prev_hash")
  hash          String?

  @@index([targetType, targetId, seq])
  @@index([actorEntityId, occurredAt])
  @@map("audit_event")
}

/// Transactional outbox (ADR-0007): written in the same transaction as the domain change,
/// relayed to pg-boss queues by the worker.
model OutboxMessage {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Queue name, e.g. gateway.sync.
  topic       String
  /// What must be reconciled, e.g. apiVersion:<uuid>. Used as the job singleton key.
  aggregate   String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([createdAt], map: "outbox_pending_idx")
  @@map("outbox")
}

// ---------------------------------------------------------------------------------------------
// Entities, users and roles (SPEC.md §2, §3). Roles live here, not in Keycloak (ADR-0004).
// ---------------------------------------------------------------------------------------------

enum EntityKind {
  national
  territorial
  autonomous
  private_authorized

  @@map("entity_kind")
}

/// SPEC.md §4.1
enum EntityStatus {
  requested
  under_review
  active
  rejected
  suspended
  offboarded

  @@map("entity_status")
}

model Entity {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  legalName      String       @map("legal_name")
  shortName      String       @map("short_name")
  /// URL-safe identifier; first segment of every gateway path: /{entitySlug}/{apiSlug}/v{major}
  /// Unique among entities that are not rejected (a rejected request frees its slug).
  slug           String
  /// Organization identifier type from the country config (identifiers.organization).
  taxIdType      String       @map("tax_id_type")
  taxId          String       @map("tax_id")
  kind           EntityKind
  /// Sector code from the country config (sectors[].code).
  sector         String
  parentEntityId String?      @map("parent_entity_id") @db.Uuid
  parentEntity   Entity?      @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  childEntities  Entity[]     @relation("EntityHierarchy")
  status         EntityStatus @default(requested)
  contactEmail   String       @map("contact_email")
  website        String?
  /// Data protection officer.
  dpoName        String       @map("dpo_name")
  dpoEmail       String       @map("dpo_email")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String       @map("created_by")

  /// User who filed the onboarding request (SPEC.md §4.1); null for entities created by the seed.
  applicantId           String?   @map("applicant_id") @db.Uuid
  /// Designation document (PDF) attached to the onboarding request.
  designationDocumentId String?   @unique @map("designation_document_id") @db.Uuid
  designationDocument   Document? @relation("EntityDesignation", fields: [designationDocumentId], references: [id])
  submittedAt           DateTime? @map("submitted_at") @db.Timestamptz(3)
  decidedAt             DateTime? @map("decided_at") @db.Timestamptz(3)
  /// While suspended: also stop serving its APIs to others (SPEC.md §4.1 step 4, explicit choice).
  providerSuspended     Boolean   @default(false) @map("provider_suspended")

  memberships  Membership[]
  apis         Api[]
  applications Application[]
  designees    EntityDesignee[]
  reviews      EntityReview[]
  documents    Document[]       @relation("EntityDocuments")
  invitations  Invitation[]

  /// Slug and tax id are claimed only once a request is submitted: drafts (`requested`) the
  /// operator never sees cannot squat them, and a rejection frees them. Among drafts the first to
  /// submit wins. Predicates are written as PostgreSQL normalizes them, so Prisma sees no drift.
  @@unique([slug], map: "entity_slug_live", where: raw("(status <> ALL (ARRAY['requested'::entity_status, 'rejected'::entity_status]))"))
  @@unique([taxIdType, taxId], map: "entity_tax_id_live", where: raw("(status <> ALL (ARRAY['requested'::entity_status, 'rejected'::entity_status]))"))
  @@index([status])
  @@index([applicantId])
  @@map("entity")
}

/// Responsibilities the onboarding request designates (SPEC.md §4.1).
enum DesigneeRole {
  /// Responsable de datos: decides access requests (entity role data_steward).
  data_steward
  /// Responsable técnico: registers APIs and applications (api_publisher + app_developer).
  technical_lead

  @@map("designee_role")
}

/// People designated in an onboarding request. On approval each one is invited by e-mail.
model EntityDesignee {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityId  String       @map("entity_id") @db.Uuid
  entity    Entity       @relation(fields: [entityId], references: [id])
  role      DesigneeRole
  fullName  String       @map("full_name")
  /// Lower-case.
  email     String
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entityId, role])
  @@map("entity_designee")
}

enum EntityReviewDecision {
  approved
  changes_requested
  rejected
  /// M2-11: decisions on an active entity.
  suspended
  reactivated
  offboarded

  @@map("entity_review_decision")
}

/// Operator decisions on an onboarding request, with their comment (SPEC.md §4.1).
model EntityReview {
  id           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityId     String               @map("entity_id") @db.Uuid
  entity       Entity               @relation(fields: [entityId], references: [id])
  decision     EntityReviewDecision
  reviewerRole PlatformRole         @map("reviewer_role")
  reviewerId   String               @map("reviewer_id") @db.Uuid
  comment      String?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityId, createdAt])
  @@map("entity_review")
}

// ---------------------------------------------------------------------------------------------
// Documents (SPEC.md §3). Bytes live behind StorageService (local volume); the row keeps the hash.
// ---------------------------------------------------------------------------------------------

enum DocumentKind {
  designation
  agreement
  annex
  other

  @@map("document_kind")
}

model Document {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerEntityId String       @map("owner_entity_id") @db.Uuid
  ownerEntity   Entity       @relation("EntityDocuments", fields: [ownerEntityId], references: [id])
  kind          DocumentKind
  /// Name given by the uploader, for display only (never used as a path).
  fileName      String       @map("file_name")
  mimeType      String       @map("mime_type")
  size          Int
  /// Hex SHA-256 of the bytes; checked again on every download.
  sha256        String
  storageKey    String       @unique @map("storage_key")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String       @map("created_by")

  designationOf Entity?        @relation("EntityDesignation")
  agreementOf   Subscription[] @relation("SubscriptionAgreement")

  /// Bytes deleted by legal order (SPEC.md §5): the row and its hash stay as evidence.
  purgedAt   DateTime? @map("purged_at") @db.Timestamptz(3)
  purgedBy   String?   @map("purged_by") @db.Uuid
  /// Reference to the legal order (court, authority, file number).
  purgeOrder String?   @map("purge_order")

  @@index([ownerEntityId])
  @@map("document")
}

// ---------------------------------------------------------------------------------------------
// Invitations (ADR-0018): addressed to an e-mail; accepted by a user whose verified e-mail matches.
// ---------------------------------------------------------------------------------------------

enum InvitationStatus {
  pending
  accepted
  declined
  revoked

  @@map("invitation_status")
}

model Invitation {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityId    String           @map("entity_id") @db.Uuid
  entity      Entity           @relation(fields: [entityId], references: [id])
  /// Lower-case.
  email       String
  fullName    String?          @map("full_name")
  roles       EntityRole[]
  status      InvitationStatus @default(pending)
  /// A pending invitation past this instant can no longer be accepted.
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(3)
  invitedBy   String           @map("invited_by")
  respondedAt DateTime?        @map("responded_at") @db.Timestamptz(3)
  /// User who accepted or declined.
  respondedBy String?          @map("responded_by") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy   String           @map("created_by")

  @@unique([entityId, email], map: "invitation_one_pending", where: raw("(status = 'pending'::invitation_status)"))
  @@index([email, status])
  @@map("invitation")
}

enum UserStatus {
  active
  disabled

  @@map("user_status")
}

model User {
  id                   String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Subject (sub) of the user in the Keycloak realm rid-portal.
  keycloakSub          String     @unique @map("keycloak_sub")
  email                String     @unique
  fullName             String     @map("full_name")
  idDocumentType       String?    @map("id_document_type")
  /// Salted hash only; the document number is never stored in clear (SPEC.md §3).
  idDocumentNumberHash String?    @map("id_document_number_hash")
  status               UserStatus @default(active)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy            String     @map("created_by")

  memberships             Membership[]
  platformRoles           UserPlatformRole[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("app_user")
}

/// SPEC.md §2.1. Same values as PLATFORM_ROLES in packages/contracts.
enum PlatformRole {
  platform_admin
  platform_reviewer
  regulator
  auditor

  @@map("platform_role")
}

/// SPEC.md §2.2. Same values as ENTITY_ROLES in packages/contracts.
enum EntityRole {
  entity_admin
  api_publisher
  data_steward
  app_developer
  entity_viewer

  @@map("entity_role")
}

/// Platform roles are not tied to an entity. One row per grant, so every change is auditable.
model UserPlatformRole {
  userId    String       @map("user_id") @db.Uuid
  user      User         @relation(fields: [userId], references: [id])
  role      PlatformRole
  grantedBy String       @map("granted_by")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, role])
  @@map("user_platform_role")
}

enum MembershipStatus {
  invited
  active
  revoked

  @@map("membership_status")
}

model Membership {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  entityId  String           @map("entity_id") @db.Uuid
  entity    Entity           @relation(fields: [entityId], references: [id])
  roles     EntityRole[]
  status    MembershipStatus @default(invited)
  invitedBy String?          @map("invited_by")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy String           @map("created_by")

  @@unique([userId, entityId])
  @@index([entityId])
  @@map("membership")
}

// ---------------------------------------------------------------------------------------------
// Purposes (SPEC.md §3). Seeded from the country config; the operator can extend it (M2-10).
// ---------------------------------------------------------------------------------------------

enum PurposeSource {
  config
  operator

  @@map("purpose_source")
}

model Purpose {
  /// lower snake_case, stable (e.g. eligibility_check).
  code           String        @id
  /// Localized text, same shape as the country config: a string or { es, en }.
  name           Json
  description    Json
  legalReference String?       @map("legal_reference")
  source         PurposeSource
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String        @map("created_by")

  apiVersions   ApiVersionPurpose[]
  subscriptions Subscription[]

  @@map("purpose")
}

// ---------------------------------------------------------------------------------------------
// APIs and versions (SPEC.md §3, §4.2)
// ---------------------------------------------------------------------------------------------

enum Classification {
  public
  internal
  personal
  sensitive

  @@map("classification")
}

/// Derived from the versions (SPEC.md §3). Stored so the catalogue can filter on it, and updated in
/// the same transaction as every version transition.
enum ApiStatus {
  draft
  published
  deprecated
  retired

  @@map("api_status")
}

model Api {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Provider entity.
  entityId       String         @map("entity_id") @db.Uuid
  entity         Entity         @relation(fields: [entityId], references: [id])
  /// Unique per entity; second segment of the gateway path.
  slug           String
  name           String
  summary        String
  /// Markdown.
  description    String
  /// Sector code from the country config.
  sector         String
  tags           String[]
  classification Classification
  status         ApiStatus      @default(draft)
  ownerContact   String         @map("owner_contact")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy      String         @map("created_by")

  versions ApiVersion[]

  @@unique([entityId, slug])
  @@index([status, classification])
  @@map("api")
}

/// SPEC.md §4.2
enum ApiVersionStatus {
  draft
  in_review
  changes_requested
  approved_operator
  approved_regulator
  published
  deprecated
  retired

  @@map("api_version_status")
}

enum UpstreamType {
  node
  xroad
  direct

  @@map("upstream_type")
}

model ApiVersion {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiId            String           @map("api_id") @db.Uuid
  api              Api              @relation(fields: [apiId], references: [id])
  /// "major.minor"
  version          String
  major            Int
  minor            Int
  status           ApiVersionStatus @default(draft)
  /// OpenAPI 3.x document as uploaded and its SHA-256. `json` (not jsonb) keeps the key order of
  /// the document, so paths and operations are shown in the order the provider wrote them.
  openapiSpec      Json             @map("openapi_spec") @db.Json
  openapiSha256    String           @map("openapi_sha256")
  lintReport       Json?            @map("lint_report")
  upstreamType     UpstreamType     @map("upstream_type")
  /// Shape depends on upstreamType (SPEC.md §3.1); validated with zod in packages/contracts.
  upstream         Json
  /// /{entitySlug}/{apiSlug}/v{major}
  basePath         String           @map("base_path")
  /// [{ name, personal, sensitive }]: personal data the API exposes (minimization, SPEC.md §5).
  exposedFields    Json             @default("[]") @map("exposed_fields")
  legalBasisText   String?          @map("legal_basis_text")
  legalReferences  String[]         @map("legal_references")
  /// { availabilityTarget, maxLatencyMs, supportHours }
  sla              Json?
  /// Requests per minute per subscription unless the subscription says otherwise.
  defaultRateLimit Int              @default(600) @map("default_rate_limit")
  /// User who last sent the version to review (separation of duties: cannot approve it).
  submittedBy      String?          @map("submitted_by") @db.Uuid
  submittedAt      DateTime?        @map("submitted_at") @db.Timestamptz(3)
  publishedAt      DateTime?        @map("published_at") @db.Timestamptz(3)
  deprecatedAt     DateTime?        @map("deprecated_at") @db.Timestamptz(3)
  /// User who deprecated it; the retirement acts on their decision (ADR-0019).
  deprecatedBy     String?          @map("deprecated_by") @db.Uuid
  sunsetAt         DateTime?        @map("sunset_at") @db.Timestamptz(3)
  retiredAt        DateTime?        @map("retired_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String           @map("created_by")

  allowedPurposes ApiVersionPurpose[]
  reviews         ApiVersionReview[]
  subscriptions   Subscription[]
  revisions       ApiVersionRevision[]

  @@unique([apiId, major, minor])
  @@unique([apiId, version])
  @@index([status])
  @@map("api_version")
}

/// Earlier OpenAPI documents of a published version, replaced by compatible revisions (ADR-0019).
model ApiVersionRevision {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiVersionId  String     @map("api_version_id") @db.Uuid
  apiVersion    ApiVersion @relation(fields: [apiVersionId], references: [id])
  /// Version label the document had ("1.0" when the revision made it "1.1").
  version       String
  openapiSpec   Json       @map("openapi_spec") @db.Json
  openapiSha256 String     @map("openapi_sha256")
  /// User who replaced it.
  replacedBy    String     @map("replaced_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([apiVersionId, createdAt])
  @@map("api_version_revision")
}

/// Purposes a version lets consumers request (SPEC.md §3: allowedPurposes).
model ApiVersionPurpose {
  apiVersionId String     @map("api_version_id") @db.Uuid
  apiVersion   ApiVersion @relation(fields: [apiVersionId], references: [id])
  purposeCode  String     @map("purpose_code")
  purpose      Purpose    @relation(fields: [purposeCode], references: [code])

  @@id([apiVersionId, purposeCode])
  @@map("api_version_purpose")
}

// ---------------------------------------------------------------------------------------------
// Consumer applications and credentials (SPEC.md §3, §4.3)
// ---------------------------------------------------------------------------------------------

enum AppEnvironment {
  sandbox
  production

  @@map("app_environment")
}

enum ApplicationStatus {
  active
  suspended
  deleted

  @@map("application_status")
}

model Application {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Consumer entity.
  entityId         String            @map("entity_id") @db.Uuid
  entity           Entity            @relation(fields: [entityId], references: [id])
  name             String
  description      String
  environment      AppEnvironment
  /// Deterministic client id in the Keycloak realm rid-gateway: rid-app-<id>.
  keycloakClientId String            @unique @map("keycloak_client_id")
  status           ApplicationStatus @default(active)
  technicalContact String            @map("technical_contact")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy        String            @map("created_by")

  credentials   Credential[]
  subscriptions Subscription[]

  @@index([entityId, status])
  @@map("application")
}

enum CredentialKind {
  client_secret
  mtls_certificate

  @@map("credential_kind")
}

enum CredentialStatus {
  active
  rotating
  revoked
  expired

  @@map("credential_status")
}

/// Metadata only: secrets are shown once and never stored by the portal (SPEC.md §3).
model Credential {
  id                 String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId      String           @map("application_id") @db.Uuid
  application        Application      @relation(fields: [applicationId], references: [id])
  kind               CredentialKind
  status             CredentialStatus @default(active)
  /// Certificate thumbprint (mTLS): RFC 8705 x5t#S256, base64url of the SHA-256 of the DER.
  fingerprint        String?
  /// SHA-256 of a client secret (identifies it; the secret itself is never stored in clear).
  secretHash         String?          @map("secret_hash")
  /// Client secret sealed with AES-256-GCM (RID_SECRETS_KEY) only until the Keycloak reconciler
  /// has set it on the client; then it is erased.
  sealedSecret       String?          @map("sealed_secret")
  serial             String?
  /// Issued certificate followed by its issuing chain, PEM (public; M3-01).
  certificatePem     String?          @map("certificate_pem")
  notBefore          DateTime?        @map("not_before") @db.Timestamptz(3)
  notAfter           DateTime?        @map("not_after") @db.Timestamptz(3)
  /// When the expiry notice (lifecycle.certificateExpiryWarningDays) was queued; once per cert.
  expiryNoticeSentAt DateTime?        @map("expiry_notice_sent_at") @db.Timestamptz(3)
  /// While `rotating`: when the rotation window ends (lifecycle.credentialRotationDays) and the
  /// credential stops working (M3-04).
  rotationEndsAt     DateTime?        @map("rotation_ends_at") @db.Timestamptz(3)
  lastUsedAt         DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy          String           @map("created_by")

  /// One active client certificate per application; rotation (M3-04) keeps the old one as
  /// `rotating` while the new one is active.
  @@unique([applicationId], map: "credential_one_active_certificate", where: raw("((kind = 'mtls_certificate'::credential_kind) AND (status = 'active'::credential_status))"))
  @@index([applicationId, status])
  @@index([kind, status, notAfter])
  @@map("credential")
}

// ---------------------------------------------------------------------------------------------
// Subscriptions: access requests and grants (SPEC.md §3, §4.4)
// ---------------------------------------------------------------------------------------------

/// SPEC.md §4.4. "Pedir información" (M2-06) will add its own state.
enum SubscriptionStatus {
  pending_provider
  /// The data steward asked the requester for information (M2-06); back to pending_provider.
  info_requested
  pending_regulator
  approved
  active
  suspended
  revoked
  expired
  rejected
  withdrawn

  @@map("subscription_status")
}

model Subscription {
  id                            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  applicationId                 String             @map("application_id") @db.Uuid
  application                   Application        @relation(fields: [applicationId], references: [id])
  apiVersionId                  String             @map("api_version_id") @db.Uuid
  apiVersion                    ApiVersion         @relation(fields: [apiVersionId], references: [id])
  purposeCode                   String             @map("purpose_code")
  purpose                       Purpose            @relation(fields: [purposeCode], references: [code])
  purposeDetail                 String             @map("purpose_detail")
  legalBasisText                String             @map("legal_basis_text")
  legalReference                String?            @map("legal_reference")
  /// Exchange agreement (PDF) the requester attached (SPEC.md §4.4 step 1, M2-07).
  agreementDocumentId           String?            @map("agreement_document_id") @db.Uuid
  agreementDocument             Document?          @relation("SubscriptionAgreement", fields: [agreementDocumentId], references: [id])
  /// operationIds requested; empty = every read-only operation (SPEC.md §3).
  requestedOperations           String[]           @map("requested_operations")
  /// operationIds granted by the data steward (may be fewer than requested).
  approvedOperations            String[]           @map("approved_operations")
  /// Validity the consumer asked for; the approval may only shorten it (SPEC.md §4.4).
  requestedValidityMonths       Int                @map("requested_validity_months")
  requestedRateLimit            Int?               @map("requested_rate_limit")
  /// Granted requests per minute; null = the version's defaultRateLimit.
  rateLimitPerMinute            Int?               @map("rate_limit_per_minute")
  validFrom                     DateTime           @map("valid_from") @db.Timestamptz(3)
  validUntil                    DateTime           @map("valid_until") @db.Timestamptz(3)
  status                        SubscriptionStatus @default(pending_provider)
  endUserIdentificationRequired Boolean            @default(false) @map("end_user_identification_required")
  /// User who asked for access. Separation of duties: that user can never approve it.
  requestedBy                   String             @map("requested_by") @db.Uuid
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdBy                     String             @map("created_by")

  decisions            SubscriptionDecision[]
  /// The subscription this request renews (a prefilled new request, SPEC.md §4.4 step 6).
  renewsSubscriptionId String?                @map("renews_subscription_id") @db.Uuid
  renews               Subscription?          @relation("SubscriptionRenewal", fields: [renewsSubscriptionId], references: [id])
  renewals             Subscription[]         @relation("SubscriptionRenewal")
  /// When the renewal notice went out (lifecycle.subscriptionRenewalNoticeDays before validUntil).
  renewalNoticeSentAt  DateTime?              @map("renewal_notice_sent_at") @db.Timestamptz(3)

  /// At most one live subscription per application, API version and purpose (SPEC.md §4.4).
  /// The predicate is written exactly as PostgreSQL normalizes it, so Prisma sees no drift.
  /// A renewal (M2-06) lives next to the subscription it renews, so it is outside this index; the
  /// second index allows one live renewal per subscription.
  @@unique([applicationId, apiVersionId, purposeCode], map: "subscription_one_live_per_purpose", where: raw("((status = ANY (ARRAY['pending_provider'::subscription_status, 'info_requested'::subscription_status, 'pending_regulator'::subscription_status, 'approved'::subscription_status, 'active'::subscription_status, 'suspended'::subscription_status])) AND (renews_subscription_id IS NULL))"))
  @@unique([renewsSubscriptionId], map: "subscription_one_live_renewal", where: raw("(status = ANY (ARRAY['pending_provider'::subscription_status, 'info_requested'::subscription_status, 'pending_regulator'::subscription_status, 'approved'::subscription_status, 'active'::subscription_status, 'suspended'::subscription_status]))"))
  @@index([apiVersionId, status])
  @@index([status, validUntil])
  @@map("subscription")
}

enum DecisionKind {
  approved
  rejected
  info_requested
  suspended
  reactivated
  revoked
  /// The requester answered an info request.
  info_provided
  /// The requester gave up the request.
  withdrawn

  @@map("decision_kind")
}

/// Who decided what on a subscription, and why (SPEC.md §3: decisions[]).
model SubscriptionDecision {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subscriptionId    String       @map("subscription_id") @db.Uuid
  subscription      Subscription @relation(fields: [subscriptionId], references: [id])
  decision          DecisionKind
  decidedBy         String       @map("decided_by") @db.Uuid
  /// Entity on whose behalf the user decided, or null for platform roles (operator, regulator).
  decidedByEntityId String?      @map("decided_by_entity_id") @db.Uuid
  comment           String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([subscriptionId, createdAt])
  @@map("subscription_decision")
}

// ---------------------------------------------------------------------------------------------
// Reconciliation state (ARCHITECTURE.md §4)
// ---------------------------------------------------------------------------------------------

enum SyncStatus {
  pending
  in_sync
  drift
  error

  @@map("sync_status")
}

/// Last desired and applied state per external object (APISIX route, Keycloak client, OPA bundle).
model SyncState {
  /// Deterministic external id, e.g. apisix:route:rid-route-<apiVersionId>.
  target      String     @id
  /// apisix | keycloak | opa
  system      String
  desiredHash String     @map("desired_hash")
  appliedHash String?    @map("applied_hash")
  status      SyncStatus @default(pending)
  lastError   String?    @map("last_error")
  attempts    Int        @default(0)
  appliedAt   DateTime?  @map("applied_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@map("sync_state")
}

enum ReviewDecision {
  approved
  changes_requested

  @@map("review_decision")
}

/// Operator (and later regulator) decisions on an API version (SPEC.md §4.2). Append-only.
model ApiVersionReview {
  id           String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  apiVersionId String         @map("api_version_id") @db.Uuid
  apiVersion   ApiVersion     @relation(fields: [apiVersionId], references: [id])
  decision     ReviewDecision
  /// Platform role the reviewer acted with (platform_reviewer, platform_admin, regulator).
  reviewerRole PlatformRole   @map("reviewer_role")
  reviewerId   String         @map("reviewer_id") @db.Uuid
  comment      String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([apiVersionId, createdAt])
  @@map("api_version_review")
}

/// Revisions of the OPA bundle served to the gateways (ARCHITECTURE.md §4.2). When OPA reports a
/// revision as active, the approved subscriptions it contains become active. Technical table:
/// old revisions are pruned.
model PolicyBundle {
  /// SHA-256 of the bundle archive (also its ETag and manifest revision).
  revision        String   @id
  subscriptionIds String[] @map("subscription_ids") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("policy_bundle")
}

/// Where the gateway read the data subject of a registered call (ADR-0015, ADR-0017).
enum SubjectSource {
  path
  body

  @@map("subject_source")
}

/// Transparency register (ADR-0015, MT-03): one row per call that reached a provider on an
/// operation with a data subject. The subject is only the keyed pseudonym OPA computed; never
/// the document number, the path or any content. Insert-only: rid_app may not update or delete,
/// a trigger refuses it to everyone, and only purge_subject_access_records() removes rows past
/// retention. Ids are snapshots, without foreign keys: the record is evidence and must outlive
/// later changes to what it points to.
model SubjectAccessRecord {
  id               String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// When the gateway finished the call ($msec).
  occurredAt       DateTime      @map("occurred_at") @db.Timestamptz(3)
  receivedAt       DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  gatewayNode      String        @map("gateway_node")
  /// nginx $request_id: random, chosen by the gateway; with the node, the idempotency key.
  gatewayRequestId String        @map("gateway_request_id")
  /// X-Request-Id for correlation with the consumer and the provider (the client may set it).
  requestId        String?       @map("request_id")
  /// HMAC-SHA-256(subject key, country|type|number), hex.
  subjectRef       String        @map("subject_ref")
  subjectSource    SubjectSource @map("subject_source")
  providerEntityId String        @map("provider_entity_id") @db.Uuid
  apiId            String        @map("api_id") @db.Uuid
  apiVersionId     String        @map("api_version_id") @db.Uuid
  operationId      String        @map("operation_id")
  /// The data the version exposes, as declared when it was published.
  exposedFields    Json          @map("exposed_fields")
  consumerEntityId String        @map("consumer_entity_id") @db.Uuid
  applicationId    String        @map("application_id") @db.Uuid
  subscriptionId   String        @map("subscription_id") @db.Uuid
  purposeCode      String        @map("purpose_code")
  /// Keyed hash of the official behind the call, when the consumer sent one.
  endUserHash      String?       @map("end_user_hash")
  /// HTTP status the consumer received.
  status           Int

  @@unique([gatewayNode, gatewayRequestId])
  @@index([subjectRef, occurredAt])
  @@index([occurredAt])
  @@map("subject_access_record")
}

/// Retention floor of the transparency register (one row): only the schema owner writes it, so
/// the runtime role cannot shorten retention. See the migration subject_access_retention_floor.
model SubjectAccessRetention {
  singleton Boolean @id @default(true)
  minMonths Int     @map("min_months")

  @@map("subject_access_retention")
}

/// One row per purge of the transparency register, written by the purge function itself.
model SubjectAccessPurgeLog {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purgedAt        DateTime @default(now()) @map("purged_at") @db.Timestamptz(3)
  /// Database role that called the purge.
  calledBy        String   @map("called_by")
  retentionMonths Int      @map("retention_months")
  minMonths       Int      @map("min_months")
  deleted         BigInt

  @@map("subject_access_purge_log")
}

/// A sealed batch of the transparency register (ADR-0016, MT-04): Merkle root of its records,
/// chained to the previous checkpoint and signed by the operator (compact JWS, EdDSA).
/// Insert-only.
model TransparencyCheckpoint {
  seq       Int      @id
  treeSize  Int      @map("tree_size")
  /// Merkle root (RFC 9162), hex.
  root      String
  /// checkpointHash of seq - 1; null for the first.
  prev      String?
  /// checkpointHash of this one: what the next checkpoint links to.
  hash      String   @unique
  sealedAt  DateTime @map("sealed_at") @db.Timestamptz(3)
  /// Key that signed it (JWKS kid).
  kid       String
  jws       String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  leaves    TransparencyLeaf[]
  timestamp TransparencyTimestamp?

  @@map("transparency_checkpoint")
}

/// Position of a record in its batch. Keeps the leaf hash, so the tree can be rebuilt after the
/// record itself is purged by retention. Insert-only.
model TransparencyLeaf {
  recordId      String                 @id @map("record_id") @db.Uuid
  checkpointSeq Int                    @map("checkpoint_seq")
  leafIndex     Int                    @map("leaf_index")
  leafHash      String                 @map("leaf_hash")
  /// When the call happened: tells a record purged by retention from one deleted early. From
  /// format 2 on it is part of the leaf hash, so it cannot be moved without breaking the root.
  occurredAt    DateTime               @map("occurred_at") @db.Timestamptz(3)
  /// SHA-256 of the record's canonical JSON (format 2); null in format 1 batches.
  recordDigest  String?                @map("record_digest")
  checkpoint    TransparencyCheckpoint @relation(fields: [checkpointSeq], references: [seq])

  @@unique([checkpointSeq, leafIndex])
  @@map("transparency_leaf")
}

/// RFC 3161 time-stamp of a checkpoint's JWS by an independent TSA. Separate table so the
/// checkpoint is never updated; absent while the TSA has not answered. Insert-only.
model TransparencyTimestamp {
  checkpointSeq Int                    @id @map("checkpoint_seq")
  /// DER TimeStampToken (CMS ContentInfo).
  token         Bytes
  genTime       DateTime               @map("gen_time") @db.Timestamptz(3)
  serialNumber  String                 @map("serial_number")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  checkpoint    TransparencyCheckpoint @relation(fields: [checkpointSeq], references: [seq])

  @@map("transparency_timestamp")
}

/// A citizen's request to be told about new consultations of their data (ADR-0015, MT-06), per
/// citizen app. The id is the only thing a webhook carries: the app keeps the link to its user.
model SubjectAlert {
  /// Opaque and random (v4): it reveals neither the person nor when they subscribed.
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Keyed pseudonym of the citizen as data subject (same as subject_access_record).
  subjectRef      String           @map("subject_ref")
  /// Citizen app that subscribed and receives the webhooks (azp of the citizen token).
  clientId        String           @map("client_id")
  /// Data classifications that trigger a notice; empty means notices are off.
  classifications Classification[]
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([subjectRef, clientId])
  @@map("subject_alert")
}

// ---------------------------------------------------------------------------------------------
// Notifications (SPEC.md §7, M2-08). Derived from audit events: one per event and recipient.
// ---------------------------------------------------------------------------------------------

model Notification {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  /// One of NOTIFICATION_KINDS in packages/contracts.
  kind        String
  /// { params, link }: what the texts need, never secrets nor data of the people consulted.
  payload     Json
  /// The audit event (seq) it comes from: the unique key makes delivery idempotent.
  sourceSeq   BigInt    @map("source_seq")
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  emailSentAt DateTime? @map("email_sent_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([sourceSeq, userId])
  @@index([userId, createdAt])
  @@map("notification")
}

/// E-mail choice per user and kind; absent = e-mail on. Security kinds ignore it.
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  kind      String
  email     Boolean
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([userId, kind])
  @@map("notification_preference")
}

/// Daily anchor of the audit chain (M2-09): the last event of each day (country time zone), its
/// hash and an RFC 3161 time-stamp over it. Insert-only for everyone; e-mailed to the regulator.
/// Deleting the tail of the chain leaves an anchor without its event, which verification reports.
model AuditAnchor {
  /// YYYY-MM-DD in the country's time zone.
  day        String   @id
  lastSeq    BigInt   @map("last_seq")
  lastHash   String   @map("last_hash")
  /// DER time-stamp token (RFC 3161) over the bytes of lastHash.
  tsaToken   Bytes    @map("tsa_token")
  tsaGenTime DateTime @map("tsa_gen_time") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("audit_anchor")
}

// ---------------------------------------------------------------------------------------------
// Certificates of the gateway itself, issued by step-ca (ARCHITECTURE.md §4.4, M3-02)
// ---------------------------------------------------------------------------------------------

enum GatewayCertificatePurpose {
  /// TLS server certificate of the gateway's public names (APISIX SSL object rid-ssl-gateway).
  server
  /// TLS client certificate the gateway presents to upstreams (SSL object rid-ssl-gateway-client,
  /// M3-03).
  upstream_client

  @@map("gateway_certificate_purpose")
}

/// The portal generates the key, has step-ca sign it and hands both to APISIX through the
/// reconciler. The key is sealed with RID_SECRETS_KEY, bound to the row id.
model GatewayCertificate {
  id             String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  purpose        GatewayCertificatePurpose
  /// DNS names, sorted; the first is the common name.
  hosts          String[]
  /// Certificate followed by its issuing chain, PEM.
  certificatePem String                    @map("certificate_pem")
  sealedKey      String                    @map("sealed_key")
  /// RFC 8705 x5t#S256 of the certificate.
  fingerprint    String
  notBefore      DateTime                  @map("not_before") @db.Timestamptz(3)
  notAfter       DateTime                  @map("not_after") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([purpose, notAfter])
  @@map("gateway_certificate")
}
