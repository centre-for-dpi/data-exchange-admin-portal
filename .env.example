# Copy to .env (never commit .env). Every value here is for LOCAL DEVELOPMENT ONLY.

# Country configuration (config/country/<code>.yaml)
RID_COUNTRY=co

# PostgreSQL (portal database)
POSTGRES_USER=rid
POSTGRES_PASSWORD=rid-dev-password
POSTGRES_DB=rid
# Runtime role of the API (no DDL; audit_event is append-only for it)
RID_APP_DB_PASSWORD=rid-app-dev-password
DATABASE_URL=postgresql://rid_app:rid-app-dev-password@localhost:5432/rid
# Schema owner, used only by migrations (pnpm db:migrate)
DATABASE_MIGRATION_URL=postgresql://rid:rid-dev-password@localhost:5432/rid
# Integration tests (database created by infra/postgres/init)
TEST_DATABASE_URL=postgresql://rid_app:rid-app-dev-password@localhost:5432/rid_test
TEST_DATABASE_MIGRATION_URL=postgresql://rid:rid-dev-password@localhost:5432/rid_test

# Keycloak (own database inside the same dev PostgreSQL instance)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-dev-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
# Realm rid-portal: confidential client used by apps/web (Auth.js)
RID_PORTAL_WEB_CLIENT_ID=rid-portal-web
RID_PORTAL_WEB_CLIENT_SECRET=rid-portal-web-dev-secret
# Realm rid-gateway: service account the portal uses to manage application clients
RID_GATEWAY_PROVISIONER_CLIENT_ID=rid-portal-provisioner
RID_GATEWAY_PROVISIONER_SECRET=rid-provisioner-dev-secret
KEYCLOAK_URL=http://localhost:8080
# Password of the seed users in docs/DEMO.md (dev only)
RID_DEMO_USER_PASSWORD=demo
RID_WEB_URL=http://localhost:3000

# Outgoing e-mail of the API (invitations, M2-01): Mailpit in development.
RID_SMTP_URL=smtp://localhost:1025
RID_MAIL_FROM="Portal RID <no-reply@rid.example>"
# Days an invitation to an entity stays valid.
RID_INVITATION_TTL_DAYS=14
# Uploaded documents (designation, agreements): local volume behind StorageService.
RID_DOCUMENTS_DIR=data/documents
RID_DOCUMENT_MAX_BYTES=10485760

# APISIX Admin API key (published on 127.0.0.1:9180 only)
APISIX_ADMIN_KEY=rid-dev-admin-key-change-me
APISIX_ADMIN_URL=http://localhost:9180
# How APISIX (inside the Compose network) reaches Keycloak, OPA and Fluent Bit; used by the
# reconciler when it writes routes (ARCHITECTURE.md §4.1).
RID_GATEWAY_KEYCLOAK_URL=http://keycloak:8080
RID_GATEWAY_OPA_URL=http://opa:8181
RID_GATEWAY_ACCESS_LOG_URL=http://fluent-bit:9880/
# Development stand-in for kit nodes until M4: entity slug=host:port of its mock provider
# (https://host:port: over mTLS, like an enrolled node, M3-03).
RID_DEV_NODES=salud=mock-salud:8000,socioeconomico=mock-socioeconomico:8000
# Public URL of the gateway, shown in the catalogue and in the API documentation
RID_GATEWAY_PUBLIC_URL=http://localhost:9080
# Host names of the gateway's TLS (APISIX SSL object, port 9443), comma separated; the first one
# is the certificate's common name. The portal has step-ca issue and renew that certificate (M3-02).
RID_GATEWAY_TLS_HOSTS=localhost
# Prefix of the client certificates the gateway presents to upstreams with mTLS (M3-03): one per
# provider entity, CN=<prefix>.<entity slug>. Each provider must accept only its own name.
RID_GATEWAY_CLIENT_NAME=rid-gateway

# OPA bundle: OPA downloads it from the portal API with this bearer token (internal network only)
OPA_BUNDLE_TOKEN=rid-opa-bundle-dev-token
# Salt of X-RID-End-User-Hash (HMAC-SHA-256), sent to OPA inside the bundle. 16+ characters;
# rotating it changes every hash. Dev value only: generate your own.
RID_END_USER_HASH_SALT=rid-dev-end-user-salt-change-me
# HMAC key of the data subject reference (X-RID-Subject-Ref, ADR-0015), sent to OPA in the bundle.
# 32+ characters. It turns document numbers into pseudonyms: keep it secret and stable (changing it
# breaks the link between a citizen and their past records). Dev value only: generate your own.
RID_SUBJECT_REF_KEY=rid-dev-subject-ref-key-change-me-0123456789
OPA_PORTAL_URL=http://host.docker.internal:4000/api/v1/opa

# Transparency register (ADR-0015, MT-03): the Fluent Bit of the gateways sends records to the
# portal collector with this bearer token (internal network only). Dev value only.
RID_TRANSPARENCY_INGEST_TOKEN=rid-transparency-ingest-dev-token
# Fluent Bit TCP input of the transparency register, as APISIX reaches it
RID_GATEWAY_TRANSPARENCY_LOG=fluent-bit-transparency:5170
# Where that Fluent Bit reaches the collector (the portal API runs on the host during development)
RID_TRANSPARENCY_COLLECTOR_HOST=host.docker.internal
RID_TRANSPARENCY_COLLECTOR_PORT=4000

# step-ca key password (dev CA); the dev CA also uses it for the portal's provisioner key
STEP_CA_PASSWORD=step-dev-password
# The API signs application certificates through the JWK provisioner of step-ca (M3-01).
# RID_STEP_CA_URL follows STEP_CA_PORT. The provisioner key is read encrypted from the CA and
# opened with RID_STEP_CA_PROVISIONER_PASSWORD.
RID_STEP_CA_URL=https://localhost:9000
RID_STEP_CA_PROVISIONER=rid-portal
# Provisioner of the gateway's TLS server certificate (same password in development).
RID_STEP_CA_GATEWAY_PROVISIONER=rid-gateway-tls
RID_STEP_CA_PROVISIONER_PASSWORD=step-dev-password
# Trust anchor of the CA's TLS: its root certificate (PEM file), or the SHA-256 of that root
# (`step certificate fingerprint`, see infra/step-ca/README.md). Required in production; in
# development, with both empty, the API trusts the root the CA serves and logs its fingerprint.
RID_STEP_CA_ROOT_FILE=
RID_STEP_CA_ROOT_FINGERPRINT=

# Web (Auth.js). AUTH_SECRET encrypts the session cookie: generate one with `openssl rand -base64 32`.
AUTH_SECRET=rid-dev-auth-secret-change-me-0123456789abcdef
AUTH_URL=http://localhost:3000
# Portal API as seen from the web server
RID_API_URL=http://localhost:4000

# Portal API
# Seals client secrets until Keycloak has them (32 bytes, base64). Dev value only: generate your own
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RID_SECRETS_KEY=cAqP7itRmcayHYeusG8Y/YLs+fs75qDu7WN3yuKpvvM=
API_PORT=4000

# Host ports (defaults from CLAUDE.md). Change only if a port is already taken on your machine;
# if you change KEYCLOAK_PORT, Keycloak's issuer (KC_HOSTNAME) follows it.
# POSTGRES_PORT=5432
# KEYCLOAK_PORT=8080
# APISIX_HTTP_PORT=9080
# APISIX_HTTPS_PORT=9443
# APISIX_ADMIN_PORT=9180
# OPA_PORT=8181
# STEP_CA_PORT=9000
# OPENSEARCH_PORT=9200
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# MOCK_SALUD_PORT=8101
# MOCK_SOCIOECONOMICO_PORT=8102

# Transparency evidence (ADR-0016, MT-04): sealed batches signed by the operator and time-stamped
# by an independent RFC 3161 TSA. DEVELOPMENT signing key (private JWK, Ed25519, with kid): in
# production it comes from the secret manager and is never committed. Retired public keys stay in
# RID_TRANSPARENCY_RETIRED_JWKS (JSON array) so old receipts keep verifying.
RID_TRANSPARENCY_SIGNING_JWK='{"crv":"Ed25519","d":"MD5QRBOCVLtS7ZqHolouu6r-uDAZ_emeb9QHa5Xolu4","x":"wyQaQi_ugM0MHtnmEDsu8wrEdrcYj7nffLL8SGpNi9I","kty":"OKP","kid":"rid-dev-2026-11","alg":"EdDSA","use":"sig"}'
RID_TRANSPARENCY_RETIRED_JWKS='[]'
RID_TRANSPARENCY_LOG_ID=rid-transparency-dev
RID_TSA_URL=http://localhost:3004
RID_TSA_PORT=3004
# Records per checkpoint and seconds between sealing rounds.
RID_TRANSPARENCY_BATCH_MAX=1000
RID_TRANSPARENCY_SEAL_INTERVAL_SECONDS=10
# How often deprecated API versions past their retirement date are retired (ADR-0019).
RID_LIFECYCLE_INTERVAL_SECONDS=300
# How often finished days of the audit trail are anchored and time-stamped (M2-09).
RID_AUDIT_ANCHOR_INTERVAL_SECONDS=3600

# Citizen API (ADR-0015, MT-05). In development the national digital identity is simulated by
# the Keycloak realm rid-citizens; carpeta-ciudadana is the only citizen app it accepts (the
# reference Carpeta of MT-07 runs on RID_CARPETA_URL). The API derives the data subject's
# pseudonym from the document claims of the citizen's token: it never takes a number as input.
RID_CARPETA_CLIENT_SECRET=carpeta-ciudadana-dev-secret
RID_CARPETA_URL=http://localhost:3100
RID_CITIZEN_ISSUER=http://localhost:8080/realms/rid-citizens
RID_CITIZEN_AUDIENCE=rid-transparency-api
RID_CITIZEN_CLIENTS=carpeta-ciudadana
RID_CITIZEN_DOCUMENT_TYPE_CLAIM=document_type
RID_CITIZEN_DOCUMENT_NUMBER_CLAIM=document_number

# Citizen notices (MT-06): citizen apps that receive the signed webhooks (Standard Webhooks), by
# client id. DEVELOPMENT secret; the reference Carpeta (MT-07) listens on RID_CARPETA_URL.
RID_CITIZEN_APPS='{"carpeta-ciudadana":{"webhookUrl":"http://localhost:3100/api/rid/alerts","webhookSecret":"whsec_zFd//133G1KfhPeWQB4neKh1UGKsJbOuDHxEsNv/QSc="}}'
# The reference citizen app (infra/mock-citizen-app, MT-07) verifies those webhooks with the same
# secret, keeps its users' emails (the portal never sees them) and sends notices to Mailpit.
CITIZEN_APP_WEBHOOK_SECRET=whsec_zFd//133G1KfhPeWQB4neKh1UGKsJbOuDHxEsNv/QSc=
