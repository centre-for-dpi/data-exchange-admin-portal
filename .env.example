# Copy to .env (never commit .env). Every value here is for LOCAL DEVELOPMENT ONLY.

# Country configuration (config/country/<code>.yaml)
DEN_COUNTRY=co

# PostgreSQL (portal database)
POSTGRES_USER=den
POSTGRES_PASSWORD=den-dev-password
POSTGRES_DB=den
# Runtime role of the API (no DDL; audit_event is append-only for it)
DEN_APP_DB_PASSWORD=den-app-dev-password
DATABASE_URL=postgresql://den_app:den-app-dev-password@localhost:5432/den
# Schema owner, used only by migrations (pnpm db:migrate)
DATABASE_MIGRATION_URL=postgresql://den:den-dev-password@localhost:5432/den
# Integration tests (database created by infra/postgres/init)
TEST_DATABASE_URL=postgresql://den_app:den-app-dev-password@localhost:5432/den_test
TEST_DATABASE_MIGRATION_URL=postgresql://den:den-dev-password@localhost:5432/den_test

# Keycloak (own database inside the same dev PostgreSQL instance)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak-dev-password
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-password
# Realm den-portal: confidential client used by apps/web (Auth.js)
DEN_PORTAL_WEB_CLIENT_ID=den-portal-web
DEN_PORTAL_WEB_CLIENT_SECRET=den-portal-web-dev-secret
# Realm den-gateway: service account the portal uses to manage application clients
DEN_GATEWAY_PROVISIONER_CLIENT_ID=den-portal-provisioner
DEN_GATEWAY_PROVISIONER_SECRET=den-provisioner-dev-secret
KEYCLOAK_URL=http://localhost:8080
# Where the API calls Keycloak's Admin API (the den-gateway reconciler, demo-users): KEYCLOAK_URL
# when empty. The pilot uses the Compose name, http://keycloak:8080/auth: its proxy does not
# publish /auth/admin (B-28).
# DEN_KEYCLOAK_ADMIN_URL=
# Password of the seed users in docs/DEMO.md (dev only)
DEN_DEMO_USER_PASSWORD=den-demo-password
# The seed users with a critical role (platform, operator, regulator, auditor, data steward;
# M-29): DEN_DEMO_USER_PASSWORD when empty (development); the pilot gets a password of their own.
# DEN_DEMO_CRITICAL_PASSWORD=
# One-time code key (TOTP) of the seed users with a critical role (M3-08, dev and demo only);
# `pnpm demo:otp` prints the current code and the key for an authenticator app
DEN_DEMO_TOTP_SECRET=den-demo-totp-secret
DEN_WEB_URL=http://localhost:3000

# Outgoing e-mail of the API (invitations, M2-01): Mailpit in development.
DEN_SMTP_URL=smtp://127.0.0.1:1025
DEN_MAIL_FROM="Portal DEN <no-reply@den.example>"
# Days an invitation to an entity stays valid.
DEN_INVITATION_TTL_DAYS=14
# Hours a node enrollment token stays valid (SPEC.md §4.6: 72).
DEN_NODE_ENROLLMENT_TTL_HOURS=72
# Uploaded documents (designation, agreements): local volume behind StorageService.
DEN_DOCUMENTS_DIR=data/documents
DEN_DOCUMENT_MAX_BYTES=10485760
# Largest kit bundle the operator can mirror on the portal (P-03), in the same directory.
# DEN_KIT_BUNDLE_MAX_BYTES=134217728
# Antivirus of uploaded documents (M6-08): ClamAV's clamd, `--profile antivirus` of Compose. Set,
# every document is scanned before it is stored and an upload fails while clamd does not answer.
# Empty: no scan. Pilot: tcp://clamav:3310 (install.sh sets it when the antivirus is on).
# DEN_CLAMAV_URL=tcp://localhost:3310

# APISIX Admin API key (published on 127.0.0.1:9180 only)
APISIX_ADMIN_KEY=den-dev-admin-key-change-me
APISIX_ADMIN_URL=http://localhost:9180
# etcd's users (B-15, ADR-0031): APISIX reads and writes /apisix with its own; root is for
# etcd-init (infra/etcd/init.sh), which turns authentication on, and for the operator. Changing
# APISIX's here changes it in etcd on the next start; root's cannot change once set (OPERATIONS.md).
# Dev values only.
ETCD_ROOT_PASSWORD=den-etcd-root-dev-password
APISIX_ETCD_PASSWORD=den-apisix-etcd-dev-password
# How APISIX (inside the Compose network) reaches Keycloak, OPA and Fluent Bit; used by the
# reconciler when it writes routes (ARCHITECTURE.md §4.1).
DEN_GATEWAY_KEYCLOAK_URL=http://keycloak:8080
DEN_GATEWAY_OPA_URL=http://opa:8181
DEN_GATEWAY_ACCESS_LOG_URL=http://fluent-bit:9880/
# Development stand-in for kit nodes until M4: entity slug=host:port of its mock provider
# (https://host:port: over mTLS, like an enrolled node, M3-03). `prefix-*` covers the slugs that
# start with it: carga-* are the synthetic entities of the load test (M6-03, pnpm load:seed).
DEN_DEV_NODES=salud=mock-salud:8000,socioeconomico=mock-socioeconomico:8000,carga-*=mock-salud:8000
# Public URL of the gateway, shown in the catalogue and in the API documentation
DEN_GATEWAY_PUBLIC_URL=https://localhost:9443
# Host names of the gateway's TLS (APISIX SSL object, port 9443), comma separated; the first one
# is the certificate's common name. The portal has step-ca issue and renew that certificate (M3-02).
DEN_GATEWAY_TLS_HOSTS=localhost
# Nodes of the gateway (APISIX) serving traffic: each counts requests on its own, so every node
# gets its share of a subscription's limit per minute (ADR-0020, M3-05).
DEN_GATEWAY_NODES=1
# Prefix of the client certificates the gateway presents to upstreams with mTLS (M3-03): one per
# provider entity, CN=<prefix>.<entity slug>. Each provider must accept only its own name.
DEN_GATEWAY_CLIENT_NAME=den-gateway

# OPA bundle: OPA downloads it from the portal API with this bearer token (internal network only)
OPA_BUNDLE_TOKEN=den-opa-bundle-dev-token
# OPA's API needs a token (B-15, ADR-0031): the gateway asks for decisions with
# DEN_OPA_DECISION_TOKEN (the reconciler writes it into each route, and OPA checks it); reading
# OPA's data (the keys below) or replacing a policy needs DEN_OPA_ADMIN_TOKEN as a bearer token,
# the operator's and the integration tests'. 32+ characters each. Dev values only.
DEN_OPA_DECISION_TOKEN=den-opa-decision-dev-token-change-me-0123
DEN_OPA_ADMIN_TOKEN=den-opa-admin-dev-token-change-me-0123456789
# Salt of X-DEN-End-User-Hash (HMAC-SHA-256), sent to OPA inside the bundle. 16+ characters;
# rotating it changes every hash. Dev value only: generate your own.
DEN_END_USER_HASH_SALT=den-dev-end-user-salt-change-me
# HMAC key of the data subject reference (X-DEN-Subject-Ref, ADR-0015), sent to OPA in the bundle.
# 32+ characters. It turns document numbers into pseudonyms: keep it secret and stable (changing it
# breaks the link between a citizen and their past records). Dev value only: generate your own.
DEN_SUBJECT_REF_KEY=den-dev-subject-ref-key-change-me-0123456789
OPA_PORTAL_URL=http://host.docker.internal:4000/api/v1/opa

# Transparency register (ADR-0015, MT-03): the Fluent Bit of the gateways sends records to the
# portal collector with this bearer token (internal network only). Dev value only.
DEN_TRANSPARENCY_INGEST_TOKEN=den-transparency-ingest-dev-token
# Fluent Bit TCP input of the transparency register, as APISIX reaches it
DEN_GATEWAY_TRANSPARENCY_LOG=fluent-bit-transparency:5170
# Where that Fluent Bit reaches the collector (the portal API runs on the host during development)
DEN_TRANSPARENCY_COLLECTOR_HOST=host.docker.internal
DEN_TRANSPARENCY_COLLECTOR_PORT=4000

# Password of the CA's own keys (dev CA): only the step-ca container gets it, never the API.
STEP_CA_PASSWORD=step-dev-password
# The API signs application certificates through the JWK provisioner of step-ca (M3-01).
# DEN_STEP_CA_URL follows STEP_CA_PORT. The provisioner key is read encrypted from the CA and
# opened with DEN_STEP_CA_PROVISIONER_PASSWORD.
DEN_STEP_CA_URL=https://localhost:9000
DEN_STEP_CA_PROVISIONER=den-portal
# Provisioner of the gateway's TLS server certificate.
DEN_STEP_CA_GATEWAY_PROVISIONER=den-gateway-tls
# Each provisioner's key has its own password (B-16; infra/step-ca/configure.sh gives the key a
# new pair when one changes). Development keeps the CA's for all of them; the gateway's and the
# nodes' provisioners default to DEN_STEP_CA_PROVISIONER_PASSWORD. make-deploy-env generates three.
DEN_STEP_CA_PROVISIONER_PASSWORD=step-dev-password
# DEN_STEP_CA_GATEWAY_PROVISIONER_PASSWORD=
# DEN_STEP_CA_NODE_PROVISIONER_PASSWORD=
# Trust anchor of the CA's TLS: its root certificate (PEM file), or the SHA-256 of that root
# (`step certificate fingerprint`, see infra/step-ca/README.md). Required in production; in
# development, with both empty, the API trusts the root the CA serves and logs its fingerprint.
DEN_STEP_CA_ROOT_FILE=
DEN_STEP_CA_ROOT_FINGERPRINT=

# Web (Auth.js). AUTH_SECRET encrypts the session cookie: generate one with `openssl rand -base64 32`.
AUTH_SECRET=den-dev-auth-secret-change-me-0123456789abcdef
# The realm's ssoSessionIdleTimeout, in seconds: the portal warns two minutes before (WCAG 2.2.1).
# DEN_SESSION_IDLE_SECONDS=1800
AUTH_URL=http://localhost:3000
# Portal API as seen from the web server
DEN_API_URL=http://localhost:4000

# Portal API
# Seals client secrets until Keycloak has them (32 bytes, base64). Dev value only: generate your own
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DEN_SECRETS_KEY=cAqP7itRmcayHYeusG8Y/YLs+fs75qDu7WN3yuKpvvM=
# Rotation (OPERATIONS.md §5.6): the previous keys, comma-separated, still open what they sealed
# until `secrets:reseal` has sealed it again with DEN_SECRETS_KEY. Empty when not rotating.
# DEN_SECRETS_KEYS_PREVIOUS=
API_PORT=4000

# Host ports (defaults from CLAUDE.md). Change only if a port is already taken on your machine;
# if you change KEYCLOAK_PORT, Keycloak's issuer (KC_HOSTNAME) follows it.
# POSTGRES_PORT=5432
# KEYCLOAK_PORT=8080
# APISIX_HTTP_PORT=9080
# APISIX_HTTPS_PORT=9443
# APISIX_ADMIN_PORT=9180
# OPA_PORT=8181
# STEP_CA_PORT=9000
# OPENSEARCH_PORT=9200
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
# MOCK_SALUD_PORT=8101
# MOCK_SOCIOECONOMICO_PORT=8102

# Transparency evidence (ADR-0016, MT-04): sealed batches signed by the operator and time-stamped
# by an independent RFC 3161 TSA. DEVELOPMENT signing key (private JWK, Ed25519, with kid): in
# production it comes from the secret manager and is never committed. Retired public keys stay in
# DEN_TRANSPARENCY_RETIRED_JWKS (JSON array) so old receipts keep verifying.
DEN_TRANSPARENCY_SIGNING_JWK='{"crv":"Ed25519","d":"MD5QRBOCVLtS7ZqHolouu6r-uDAZ_emeb9QHa5Xolu4","x":"wyQaQi_ugM0MHtnmEDsu8wrEdrcYj7nffLL8SGpNi9I","kty":"OKP","kid":"den-dev-2026-11","alg":"EdDSA","use":"sig"}'
DEN_TRANSPARENCY_RETIRED_JWKS='[]'
DEN_TRANSPARENCY_LOG_ID=den-transparency-dev
# The time-stamping authority (ADR-0032). Without DEN_TSA_ROOTS_FILE: the development TSA (sigstore
# timestamp-server, infra/tsa), DEN_TSA_URL its base, and its chain fetched from the TSA itself;
# the API says loudly at start in production that it is not independent of the operator. With the
# country's accredited TSA: DEN_TSA_URL the full URL of its RFC 3161 endpoint, DEN_TSA_ROOTS_FILE
# a PEM file with its roots (never downloaded from it), and DEN_TSA_REQUIRE_INDEPENDENT=true so
# the API refuses to start with the development one. CITIZEN_APP_TSA_ROOTS_FILE pins them in the
# reference citizen app.
DEN_TSA_URL=http://localhost:3004
DEN_TSA_ROOTS_FILE=
DEN_TSA_REQUIRE_INDEPENDENT=false
DEN_TSA_PORT=3004
# Records per checkpoint and seconds between sealing rounds.
DEN_TRANSPARENCY_BATCH_MAX=1000
DEN_TRANSPARENCY_SEAL_INTERVAL_SECONDS=10
# How often deprecated API versions past their retirement date are retired (ADR-0019).
DEN_LIFECYCLE_INTERVAL_SECONDS=300
# How often finished days of the audit trail are anchored and time-stamped (M2-09).
DEN_AUDIT_ANCHOR_INTERVAL_SECONDS=3600
# Days a relayed outbox row is kept before the worker purges it (whole number >= 1; default 7).
DEN_OUTBOX_RETENTION_DAYS=7

# Citizen API (ADR-0015, MT-05). In development the national digital identity is simulated by
# the Keycloak realm den-citizens; citizen-app is the only citizen app it accepts (the
# reference citizen app of MT-07 runs on DEN_CITIZEN_APP_URL). The API derives the data subject's
# pseudonym from the document claims of the citizen's token: it never takes a number as input.
DEN_CITIZEN_APP_CLIENT_SECRET=citizen-app-dev-secret
DEN_CITIZEN_APP_URL=http://localhost:3100
DEN_CITIZEN_ISSUER=http://localhost:8080/realms/den-citizens
DEN_CITIZEN_AUDIENCE=den-transparency-api
DEN_CITIZEN_CLIENTS=citizen-app
DEN_CITIZEN_DOCUMENT_TYPE_CLAIM=document_type
DEN_CITIZEN_DOCUMENT_NUMBER_CLAIM=document_number

# Citizen notices (MT-06): citizen apps that receive the signed webhooks (Standard Webhooks), by
# client id. DEVELOPMENT secret; the reference citizen app (MT-07) listens on DEN_CITIZEN_APP_URL.
DEN_CITIZEN_APPS='{"citizen-app":{"webhookUrl":"http://localhost:3100/api/den/alerts","webhookSecret":"whsec_zFd//133G1KfhPeWQB4neKh1UGKsJbOuDHxEsNv/QSc="}}'
# The reference citizen app (infra/mock-citizen-app, MT-07) verifies those webhooks with the same
# secret, keeps its users' emails (the portal never sees them) and sends notices to Mailpit.
CITIZEN_APP_WEBHOOK_SECRET=whsec_zFd//133G1KfhPeWQB4neKh1UGKsJbOuDHxEsNv/QSc=

# --- Kit nodes (M4, ARCHITECTURE.md §10) ---
# Control channel: nodes call the portal through the gateway's control route with their
# certificate. APISIX adds this token so the portal believes the thumbprint it passes. Dev value.
DEN_NODE_CONTROL_TOKEN=den-node-control-dev-token-change-me
# The portal API as APISIX reaches it (the API runs on the host during development).
DEN_GATEWAY_PORTAL_API_URL=http://host.docker.internal:4000
# Base URL nodes use for the control channel (defaults to DEN_GATEWAY_PUBLIC_URL).
# DEN_NODE_CONTROL_URL=https://localhost:9443
# WireGuard hub (M4-03): tunnel subnet (hub on its first address), the hub's key pair and where
# nodes reach it (UDP). Dev keys only: make-deploy-env generates real ones.
DEN_WG_SUBNET=10.77.0.0/16
DEN_WG_HUB_PRIVATE_KEY=WE1vG8GUky8mng5ruxM3Wf+H02EjvzKT7IZXtpLz6lA=
DEN_WG_HUB_PUBLIC_KEY=WzAtiqy5RqfiXQkhNCxPueZ32h7Nxtjk5oIJd/u0zhs=
DEN_WG_HUB_ENDPOINT=wg-hub:51820
# Agent of the hub (internal network only): the portal's reconciler sets its peers with this
# token. Dev value only.
DEN_WG_HUB_AGENT_URL=http://localhost:8095
DEN_WG_HUB_AGENT_TOKEN=den-wg-hub-agent-dev-token
# The hub's SNI router as APISIX reaches it: versions on enrolled nodes go there (M4-04).
DEN_GATEWAY_WG_HUB=wg-hub:8443
# Optional: heartbeat period, offline threshold (SPEC.md §4.6: 5 min), node certificate validity,
# oldest kit version accepted.
# DEN_NODE_HEARTBEAT_SECONDS=60
# DEN_NODE_OFFLINE_AFTER_SECONDS=300
# DEN_NODE_CERT_VALIDITY_HOURS=2160
# DEN_NODE_MIN_KIT_VERSION=1.0.0

# --- X-Road (M4-05, SPIKE S-5): the operator's Security Server and client subsystem. Without
# them, xroad versions have no gateway route, and the portal does not offer X-Road to providers
# even if the country lists it in features.upstreams (P-04, ADR-0029).
# DEN_XROAD_SECURITY_SERVER_URL=https://ss.example:8443
# DEN_XROAD_CLIENT=CO/GOV/9000000001/DEN-GATEWAY
# DEN_XROAD_SECURITY_SERVER_CA=/run/secrets/xroad-ss-ca.pem

# --- Validations at submission (M4-06): check routes of versions in review, behind this token;
# the healthcheck goes through APISIX and the contract test through the runner (Schemathesis).
DEN_VALIDATION_TOKEN=den-validation-dev-token-change-me
DEN_GATEWAY_INTERNAL_URL=http://localhost:9080
DEN_CONTRACT_RUNNER_URL=http://localhost:8096
DEN_CONTRACT_RUNNER_TOKEN=den-contract-runner-dev-token
# APISIX as the runner reaches it (inside Compose).
DEN_CONTRACT_RUNNER_GATEWAY_URL=http://apisix:9080
# DEN_CONTRACT_MAX_EXAMPLES=20
# DEN_CONTRACT_TIMEOUT_SECONDS=120

# --- Usage analytics (M5): the access logs in OpenSearch (observability profile). The API keeps
# their index template and retention (retention.accessLogMonths) and reads them for the usage
# screens. DEN_OPENSEARCH_AUTH=user:password when the security plugin is on.
DEN_OPENSEARCH_URL=http://localhost:9200

# --- Metrics and alerts (M5-06): Prometheus scrapes the API GET /metrics with this token (dev
# value; without it /metrics answers 404). The indicators read the gateway availability from
# Prometheus. Grafana on http://localhost:3001 (user admin).
DEN_METRICS_TOKEN=den-metrics-dev-token-change-me
DEN_PROMETHEUS_URL=http://localhost:9090
GRAFANA_ADMIN_PASSWORD=den-grafana-dev
# PROMETHEUS_RETENTION=30d

# APISIX encrypts the private keys it keeps in etcd with this key (16 characters; M6-01). Dev
# value: make-deploy-env generates a real one.
DEN_APISIX_KEYRING=den-dev-keyring1

# Backups of the pilot's PostgreSQL with pgBackRest (M6-06, docker-compose.deploy.yml only):
# the repository's encryption key (without it no backup can be restored: keep a copy off the
# server) and when the daily backup runs (UTC hour; full on DEN_BACKUP_FULL_DAY, 0 = Sunday,
# differential the other days). make-deploy-env generates the key.
# PGBACKREST_REPO1_CIPHER_PASS=
# DEN_BACKUP_HOUR=2
# DEN_BACKUP_FULL_DAY=0

# API rate limits and proxy (M6-01). Per minute: every caller, by verified user or by address;
# and the expensive routes (uploads, new versions, onboarding, invitations, node enrollment).
# DEN_RATE_LIMIT_PER_MINUTE=600
# DEN_RATE_LIMIT_STRICT_PER_MINUTE=30
# Who may set X-Forwarded-For: the proxy's address or network (comma-separated), or a number of
# hops. Empty in development (no proxy in front of the API).
# DEN_TRUST_PROXY=

# Format of the API's log lines (masked either way: query strings, identification numbers,
# e-mail addresses, URL credentials): text (default) or json, one object per line for a log
# collector (the Helm chart sets json).
# DEN_LOG_FORMAT=

# The first platform administrator of a network without seed (production, M6-05): whoever signs in
# first with this address, verified by Keycloak, while the network has none. Empty in development
# (the seed gives the roles); remove it once that person is in.
# DEN_BOOTSTRAP_ADMIN_EMAIL=
