# Routes of the portal and the gateway, for the bundled proxy (infra/compose/docker-compose.edge.yml)
# or a Traefik already on the server (file provider). install.sh writes
# infra/edge/dynamic/den.yml (or infra/edge/den-external.yml) from this file, replacing the
# PORTAL_HOST, GATEWAY_HOST, TLS, ENTRYPOINT, ADMIN_SOURCES and PROXY_TOKEN markers (each between
# two @). The written file holds DEN_WEB_PROXY_TOKEN: install.sh makes it readable by root only.
# Same routes as DEPLOYMENT.md §5.2; keep both in step.
#
# Never published: /api/v1/internal (transparency collector) and /api/v1/opa (OPA bundle).
# Keycloak's administration (/auth/admin, and the master realm it signs in with) only from the
# addresses in DEN_KEYCLOAK_ADMIN_ALLOW (B-28); from nowhere else, 403.

http:
  middlewares:
    den-strip-gw:
      stripPrefix: { prefixes: ['/gw'] }
    den-strip-tsa:
      stripPrefix: { prefixes: ['/tsa'] }
    # Keycloak trusts these headers on the gateway's token route only (ADR-0022): every other way
    # to Keycloak drops them.
    den-no-client-cert-headers:
      headers:
        customRequestHeaders: { SSL_CLIENT_CERT: '', ssl-client-verify: '' }
    # Per source address, in front of the API's own limits (M6-01, ASVS 2.4.1). Generous: a
    # government office often reaches the portal from one address.
    den-rate-api:
      rateLimit: { average: 50, burst: 100, period: 1s }
    den-rate-auth:
      rateLimit: { average: 20, burst: 60, period: 1s }
    # The web believes X-Forwarded-For only from requests with this token (M-27): set here,
    # overwriting whatever a client sent.
    den-web-from-proxy:
      headers:
        customRequestHeaders: { X-DEN-Proxy-Token: '@PROXY_TOKEN@' }
    # Keycloak's admin console and the master realm: the operator's addresses only (B-28).
    den-keycloak-admin:
      ipAllowList: { sourceRange: [@ADMIN_SOURCES@] }

  routers:
    den-web:
      rule: 'Host(`@PORTAL_HOST@`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-web
      middlewares: [den-web-from-proxy]
      tls: @TLS@
    den-api:
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/api/v1`) && !PathPrefix(`/api/v1/internal`) && !PathPrefix(`/api/v1/opa`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-api
      middlewares: [den-rate-api]
      tls: @TLS@
    den-auth:
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/auth`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-keycloak
      middlewares: [den-no-client-cert-headers, den-rate-auth]
      tls: @TLS@
    den-auth-admin:
      rule: 'Host(`@PORTAL_HOST@`) && (PathPrefix(`/auth/admin`) || PathPrefix(`/auth/realms/master`))'
      entryPoints: [@ENTRYPOINT@]
      service: den-keycloak
      middlewares: [den-keycloak-admin, den-no-client-cert-headers, den-rate-auth]
      tls: @TLS@
    den-gw:
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/gw`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-apisix
      middlewares: [den-strip-gw]
      tls: @TLS@
    den-mail:
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/mail`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-mailpit
      tls: @TLS@
    den-citizen-app:
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/citizen-app`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-citizen-app
      tls: @TLS@
    den-grafana:
      # The operator's dashboard (M5-06), with Grafana's own login.
      rule: 'Host(`@PORTAL_HOST@`) && PathPrefix(`/grafana`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-grafana
      middlewares: [den-rate-auth]
      tls: @TLS@
    den-tsa:
      rule: 'Host(`@PORTAL_HOST@`) && Path(`/tsa/api/v1/timestamp/certchain`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-tsa
      middlewares: [den-strip-tsa]
      tls: @TLS@

  services:
    den-web: { loadBalancer: { servers: [{ url: 'http://den-portal-web:3000' }] } }
    den-api: { loadBalancer: { servers: [{ url: 'http://den-portal-api:4000' }] } }
    den-keycloak: { loadBalancer: { servers: [{ url: 'http://den-keycloak:8080' }] } }
    den-apisix: { loadBalancer: { servers: [{ url: 'http://den-apisix:9080' }] } }
    den-mailpit: { loadBalancer: { servers: [{ url: 'http://den-mailpit:8025' }] } }
    den-citizen-app: { loadBalancer: { servers: [{ url: 'http://den-citizen-app:3100' }] } }
    den-tsa: { loadBalancer: { servers: [{ url: 'http://den-tsa:3004' }] } }
    den-grafana: { loadBalancer: { servers: [{ url: 'http://den-grafana:3000' }] } }

# The gateway's name: TLS goes through untouched to APISIX, which presents its step-ca certificate
# and asks for the client certificate (applications and kit nodes).
tcp:
  routers:
    den-gateway-mtls:
      rule: 'HostSNI(`@GATEWAY_HOST@`)'
      entryPoints: [@ENTRYPOINT@]
      service: den-apisix-tls
      tls: { passthrough: true }
  services:
    den-apisix-tls:
      loadBalancer: { servers: [{ address: 'den-apisix:9443' }] }
