{
  "realm": "den-gateway",
  "enabled": true,
  "displayName": "DEN Gateway",
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "service_account",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Client ID",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "client_id",
            "claim.name": "client_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "den-gateway-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-den-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "den-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["basic", "den-gateway-audience"],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "den-portal-provisioner",
      "name": "Portal DEN: aprovisionamiento de aplicaciones",
      "description": "Service account used by the portal reconciler to manage application clients in this realm only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${DEN_GATEWAY_PROVISIONER_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "service-account-den-portal-provisioner",
      "enabled": true,
      "serviceAccountClientId": "den-portal-provisioner",
      "clientRoles": {
        "realm-management": ["manage-clients"]
      }
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "den-secret-rotation",
        "description": "Rotation window of application secrets (M3-04): regenerating keeps the previous secret as rotated, for at most 30 days; the portal ends the window earlier.",
        "executors": [
          {
            "executor": "secret-rotation",
            "configuration": {
              "expiration-period": "315360000",
              "rotated-expiration-period": "2592000",
              "remaining-rotation-period": "0"
            }
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "den-secret-rotation",
        "description": "Applications managed by the portal (client attribute den.managed = true)",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-attributes",
            "configuration": {
              "attributes": "[{\"key\":\"den.managed\",\"value\":\"true\"}]",
              "is-negative-logic": false
            }
          }
        ],
        "profiles": ["den-secret-rotation"]
      }
    ]
  }
}
