{
  "realm": "rid-portal",
  "enabled": true,
  "displayName": "Portal RID",
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "en"],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@rid.example",
    "fromDisplayName": "Portal RID"
  },
  "clients": [
    {
      "clientId": "rid-portal-web",
      "name": "Portal RID (web)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${RID_PORTAL_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${RID_WEB_URL:http://localhost:3000}",
      "redirectUris": ["${RID_WEB_URL:http://localhost:3000}/*"],
      "webOrigins": ["${RID_WEB_URL:http://localhost:3000}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${RID_WEB_URL:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "audience-rid-portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rid-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
