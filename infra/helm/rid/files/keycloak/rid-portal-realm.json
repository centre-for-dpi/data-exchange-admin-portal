{
  "realm": "rid-portal",
  "enabled": true,
  "displayName": "Portal RID",
  "sslRequired": "external",
  "registrationAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and passwordHistory(5)",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "es",
    "en"
  ],
  "defaultLocale": "es",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "smtpServer": {
    "host": "${KC_SMTP_HOST}",
    "port": "${KC_SMTP_PORT}",
    "from": "${KC_SMTP_FROM}",
    "fromDisplayName": "Portal RID",
    "starttls": "${KC_SMTP_STARTTLS}",
    "ssl": "${KC_SMTP_SSL}",
    "auth": "true",
    "user": "${KC_SMTP_USER}",
    "password": "${KC_SMTP_PASSWORD}"
  },
  "clients": [
    {
      "clientId": "rid-portal-web",
      "name": "Portal RID (web)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${RID_PORTAL_WEB_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${RID_WEB_URL:http://localhost:3000}",
      "redirectUris": [
        "${RID_WEB_URL:http://localhost:3000}/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "${RID_WEB_URL:http://localhost:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${RID_WEB_URL:http://localhost:3000}/##${RID_WEB_URL:http://localhost:3000}/en"
      },
      "protocolMappers": [
        {
          "name": "audience-rid-portal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "rid-portal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [],
  "attributes": {
    "acr.loa.map": "{\"password\": 1, \"mfa\": 2}"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "browserFlow": "rid-browser",
  "authenticationFlows": [
    {
      "alias": "rid-browser",
      "description": "Browser login with step-up to a second factor (M3-08)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "rid-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "rid-browser-forms",
      "description": "Password, then the second factor when the portal asks for acr=mfa",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "rid-browser-password",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "rid-browser-otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "rid-browser-password",
      "description": "Level 1: password",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "rid-loa-1"
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "rid-browser-otp",
      "description": "Level 2: one-time code (TOTP)",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "rid-loa-2"
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "rid-loa-1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "rid-loa-2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "36000"
      }
    }
  ],
  "eventsEnabled": true,
  "eventsExpiration": 7776000,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "REGISTER",
    "REGISTER_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN_ERROR",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL",
    "UPDATE_PASSWORD",
    "RESET_PASSWORD",
    "RESET_PASSWORD_ERROR",
    "VERIFY_EMAIL"
  ],
  "eventsListeners": [
    "jboss-logging",
    "email"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false
}
